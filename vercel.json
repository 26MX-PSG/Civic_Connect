{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix backend ci --omit=dev",
  "buildCommand": "rm -rf public && mkdir public && cp -r *.html assets admin public/",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api", "destination": "/api/index" },
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/api-docs", "destination": "/api/index" }
  ]
}
