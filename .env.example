# Local development only. Copy to .env (cp .env.example .env). Never use these in production.
MYSQL_ROOT_PASSWORD=root_pass123
MYSQL_DATABASE=civicconnect
MYSQL_USER=civic_user
MYSQL_PASSWORD=civic_pass123
MYSQL_HOST_PORT=3307

# Backend (Express)
PORT=3000
DB_HOST=127.0.0.1
JWT_SECRET=change-me-dev-only-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TTL_MINUTES=30

# SMTP (Nodemailer) for password reset + notification emails. Gmail: use an App Password (see README "Email setup")
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CivicConnect <noreply@civicconnect.local>"

# --- Hosting (Railway etc.) only — see SETUP.md section 5 ---
# NODE_ENV=production
# MYSQL_URL=mysql://user:password@host:3306/dbname   # replaces DB_HOST / MYSQL_* when set
# DB_SSL=true                                        # only if your MySQL provider requires SSL
# ADMIN_PASSWORD=choose-a-strong-password            # required on the first boot of an empty hosted database
# SEED_DEMO_PASSWORDS=false                          # true = keep the known demo passwords on the live site
