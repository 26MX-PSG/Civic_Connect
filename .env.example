# Local development only. Copy to .env (cp .env.example .env). Never use these in production.
MYSQL_ROOT_PASSWORD=root_pass123
MYSQL_DATABASE=civicconnect
MYSQL_USER=civic_user
MYSQL_PASSWORD=civic_pass123
MYSQL_HOST_PORT=3307

# Backend (Express)
PORT=3000
DB_HOST=127.0.0.1
JWT_SECRET=change-me-dev-only-secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TTL_MINUTES=30

# SMTP (for password reset emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CivicConnect <noreply@civicconnect.local>"
